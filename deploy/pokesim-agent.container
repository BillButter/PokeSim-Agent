[Unit]
Description=PokeSim Agent - PyBoy emulator with a local web dashboard and per-game AI
Documentation=https://github.com/BillButter/PokeSim-Agent
After=network-online.target
Wants=network-online.target

[Container]
# Fully-qualified reference is required for AutoUpdate=registry.
Image=ghcr.io/billbutter/pokesim-agent:latest
AutoUpdate=registry
Pull=missing

PublishPort=127.0.0.1:8000:8000
AddHost=host.docker.internal:host-gateway

# ROMs are read-only; saves and settings live in the data directory.
Volume=%h/pokesim/roms:/roms:ro,Z
Volume=%h/pokesim/data:/data:Z

# Rootless only: map the host user onto the image's pokesim user (UID/GID
# 1000), so the bind mounts stay writable on hosts whose user is not 1000.
# Remove this line when installing the unit as root (see deploy/README.md).
UserNS=keep-id:uid=1000,gid=1000

Environment=POKESIM_HOST=0.0.0.0
Environment=POKESIM_PORT=8000
Environment=POKESIM_ROMS_DIR=/roms
Environment=POKESIM_DATA_DIR=/data
Environment=POKESIM_DEMO_GAME=true
Environment=POKESIM_FRAME_FPS=12
Environment=POKESIM_EMULATION_SPEED=0
Environment=POKESIM_DEFAULT_AI_MODE=default
Environment=POKESIM_LOG_LEVEL=INFO

# Endpoint defaults. Override these in a drop-in instead of editing this file,
# e.g. ~/.config/containers/systemd/pokesim-agent.container.d/10-ai.conf
Environment=AI_BASE_URL=http://host.docker.internal:11434/v1
Environment=AI_MODEL=llava
Environment=AI_API_KEY=
Environment=AI_POLL_INTERVAL=4
Environment=AI_MAX_CONTEXT_TURNS=8
Environment=AI_IMAGE_HISTORY=2
Environment=AI_MAX_ACTIONS=8
Environment=AI_MAX_FRAMES=240
Environment=AI_TEMPERATURE=0.2
Environment=AI_TIMEOUT=120

# The published image ships a HEALTHCHECK; kill an unhealthy container so
# systemd restarts it.
HealthOnFailure=kill

[Service]
Restart=always
# First start may need to pull the image.
TimeoutStartSec=300

[Install]
WantedBy=default.target
