# Copy to .env for local development. Docker Compose reads .env too.
# Every value is optional; the defaults below are what the app uses.

# ---- web server ----
# Bind to loopback by default because the dashboard has no authentication.
POKESIM_HOST=127.0.0.1
POKESIM_PORT=8000
POKESIM_LOG_LEVEL=INFO

# ---- game library ----
# Directory containing .gb/.gbc files (or .zip archives of one ROM).
POKESIM_ROMS_DIR=roms
# Writable directory for settings, per-game overrides and PyBoy .ram saves.
POKESIM_DATA_DIR=data
# Create a procedural demo game when no ROMs are present.
POKESIM_DEMO_GAME=true
# WebSocket frame rate cap.
POKESIM_FRAME_FPS=12
# 0 = unlimited; 1 = real time; 2 = double speed. Best for agent runs.
POKESIM_EMULATION_SPEED=0
# AI selected for newly discovered games: default | vision | manual
POKESIM_DEFAULT_AI_MODE=default

# ---- vision model (OpenAI-compatible) ----
# Ollama, LM Studio, vLLM, LocalAI, llama.cpp server or a hosted gateway.
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llava
# Optional; local servers normally do not need one.
AI_API_KEY=
# Seconds between vision turns.
AI_POLL_INTERVAL=4
# Number of previous turns kept in the rolling conversation.
AI_MAX_CONTEXT_TURNS=8
# How many previous screenshots to resend (0-8). More costs more tokens.
AI_IMAGE_HISTORY=2
# Limits applied to the model's JSON action plan.
AI_MAX_ACTIONS=8
AI_MAX_FRAMES=240
AI_TEMPERATURE=0.2
AI_TIMEOUT=120

# ---- Docker only ----
# Numeric uid:gid used to write into ./data on the host.
# POKESIM_UID=1000
# POKESIM_GID=1000
