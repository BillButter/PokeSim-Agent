# Optional overrides for docker-compose.yml / docker-compose.ghcr.yml.
# Copy only the settings you need into .env.

# Use a published version from GHCR instead of building locally.
POKESIM_IMAGE=ghcr.io/billbutter/pokesim-agent:latest

# Host paths for the pull-only Compose file.
POKESIM_ROMS_PATH=./roms
POKESIM_DATA_PATH=./data
POKESIM_HOST_BIND=127.0.0.1
POKESIM_HOST_PORT=8000

# The image runs as UID/GID 1000. If your host user differs and the data
# directory is not writable by UID 1000, set these and uncomment `user:` in
# the Compose file.
# POKESIM_UID=1000
# POKESIM_GID=1000

# Public address used for links served by the library. The Compose file derives
# it from POKESIM_HOST_PORT unless you set it explicitly. It must match the
# address in your browser or PokeSim refuses requests with HTTP 403.
# PUBLIC_URL=http://localhost:8000

# AI player defaults for new adventures. Each adventure can override this in
# Adventure settings: default, vision, or manual.
AI_MODE=default

# OpenAI-compatible vision endpoint. Only needed for adventures whose AI
# player is set to `vision`. For a model server on the Docker host:
#   AI_BASE_URL=http://host.docker.internal:11434/v1
#   AI_MODEL=qwen2.5-vl
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_POLL_INTERVAL=4
AI_MAX_CONTEXT_TURNS=8
AI_IMAGE_HISTORY=2
AI_MAX_ACTIONS=8
AI_MAX_FRAMES=120
AI_TEMPERATURE=0.2
AI_TIMEOUT=120
